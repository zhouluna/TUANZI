# Copy to a local env file that is NOT committed. Leave secrets empty in git.

# PostgreSQL on Uppcoder Spark is injected as DATABASE_URL.
# Omit it locally and the API uses web/.data/tuanzi.db (SQLite).
DATABASE_URL=postgresql://tuanzi:tuanzi@localhost:5432/tuanzi

# Required before the site is reachable by anyone else. Empty means chat
# will not call NVIDIA unless TUANZI_DEV_OPEN=1.
TUANZI_ACCESS_PASSWORD=

# Server only. Never put this in the browser, the desktop bundle, or git.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional read-only catalog of chat-capable ids. Timings are measured here.
TUANZI_MODELS_URL=https://endpoint-desk-luna.vercel.app/api/models

# How many unseen models to time on one probe pass (1–6).
TUANZI_PROBE_LIMIT=4

# Local only. 1 lets this machine call NVIDIA without a password.
TUANZI_DEV_OPEN=0

# Desktop pet, not read by the web process.
TUANZI_API_URL=http://127.0.0.1:8000
